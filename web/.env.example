# Each API base includes /api on the server; reservation-api is a Vite alias.
VITE_ACCOUNT_API_BASE_URL=/api
VITE_RESERVATION_API_BASE_URL=/reservation-api
VITE_DEV_API_PROXY_TARGET=http://localhost:5000
VITE_DEV_RESERVATION_PROXY_TARGET=http://localhost:5251
# Production: use each deployed API URL ending in /api.
# Production reservations remain blocked until that host validates JWT.
