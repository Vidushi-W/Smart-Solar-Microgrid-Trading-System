<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/solar_accent</item>
        <item name="colorPrimaryDark">@color/solar_navy</item>
        <item name="colorAccent">@color/solar_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/solar_background</item>
        <item name="android:colorAccent">@color/solar_accent</item>
        <item name="android:textColor">@color/solar_heading</item>
        <item name="android:textColorHint">@color/solar_muted</item>
        <item name="android:navigationBarColor">@color/solar_navy</item>
        <item name="android:statusBarColor">@color/solar_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="buttonStyle">@style/SolarButton</item>
        <item name="android:buttonStyle">@style/SolarButton</item>
        <item name="editTextStyle">@style/SolarField</item>
        <item name="android:editTextStyle">@style/SolarField</item>
    </style>

    <style name="SolarButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/solar_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/solar_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SolarButton.Primary">
        <item name="android:background">@drawable/solar_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="SolarField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/solar_field</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/solar_heading</item>
        <item name="android:textColorHint">@color/solar_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
